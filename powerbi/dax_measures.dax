// ==============================================================================
// PROJETO: Healthcare Analytics - Gestão Hospitalar & Eficiência Assistencial
// ARQUIVO: dax_measures.dax
// DESCRIÇÃO: Medidas DAX prontas para copiar e colar no Power BI Desktop
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. MEDIDAS DE VOLUME E DIÁRIAS (Core Metrics)
// ------------------------------------------------------------------------------

Total Internacoes = 
COUNTROWS(fato_internacoes)

Total Dias-Paciente = 
VAR _linhas = COUNTROWS(fato_internacoes)
VAR _dias_conhecidos = COUNT(fato_internacoes[dias_permanencia])
RETURN IF(_linhas = 0 || _dias_conhecidos < _linhas, BLANK(), SUM(fato_internacoes[dias_permanencia]))

Total Dias UTI = 
VAR _linhas = COUNTROWS(fato_internacoes)
VAR _dias_conhecidos = COUNT(fato_internacoes[dias_uti])
RETURN IF(_linhas = 0 || _dias_conhecidos < _linhas, BLANK(), SUM(fato_internacoes[dias_uti]))

TMP Medio (Dias) = 
// ALOS - Average Length of Stay
VAR _linhas = COUNTROWS(fato_internacoes)
VAR _dias_conhecidos = COUNT(fato_internacoes[dias_permanencia])
RETURN IF(_linhas = 0 || _dias_conhecidos < _linhas, BLANK(), AVERAGE(fato_internacoes[dias_permanencia]))

TMP Esperado Protocolo = 
AVERAGE(dim_procedimento[tmp_protocolo_previsto])

Desvio TMP vs Protocolo = 
[TMP Medio (Dias)] - [TMP Esperado Protocolo]

// ------------------------------------------------------------------------------
// 2. MEDIDAS FINANCEIRAS E DE CUSTO
// ------------------------------------------------------------------------------

// Em dados SIH/SUS, esse campo contém VAL_TOT (valor registrado da AIH),
// não recebimento ou receita contábil. Valide a semântica da fonte antes de usar.
Valor Receita / AIH (conforme origem) =
VAR _linhas = COUNTROWS(fato_internacoes)
VAR _valores_conhecidos = COUNT(fato_internacoes[receita_faturada])
RETURN IF(_linhas = 0 || _valores_conhecidos < _linhas, BLANK(), SUM(fato_internacoes[receita_faturada]))

Custo Total Hospitalar = 
VAR _linhas = COUNTROWS(fato_internacoes)
VAR _valores_conhecidos = COUNT(fato_internacoes[custo_total])
RETURN IF(_linhas = 0 || _valores_conhecidos < _linhas, BLANK(), SUM(fato_internacoes[custo_total]))

Custo Total OPME = 
VAR _linhas = COUNTROWS(fato_internacoes)
VAR _valores_conhecidos = COUNT(fato_internacoes[custo_opme])
RETURN IF(_linhas = 0 || _valores_conhecidos < _linhas, BLANK(), SUM(fato_internacoes[custo_opme]))

Custo Servicos Hospitalares = 
VAR _linhas = COUNTROWS(fato_internacoes)
VAR _valores_conhecidos = COUNT(fato_internacoes[custo_hospitalar])
RETURN IF(_linhas = 0 || _valores_conhecidos < _linhas, BLANK(), SUM(fato_internacoes[custo_hospitalar]))

Custo Servicos Profissionais = 
VAR _linhas = COUNTROWS(fato_internacoes)
VAR _valores_conhecidos = COUNT(fato_internacoes[custo_servicos_profissionais])
RETURN IF(_linhas = 0 || _valores_conhecidos < _linhas, BLANK(), SUM(fato_internacoes[custo_servicos_profissionais]))

Margem de Contribuicao Total = 
VAR _linhas = COUNTROWS(fato_internacoes)
VAR _custos_conhecidos = COUNT(fato_internacoes[custo_total])
VAR _valores_conhecidos = COUNT(fato_internacoes[receita_faturada])
RETURN
IF(
    _linhas = 0 || _custos_conhecidos < _linhas || _valores_conhecidos < _linhas,
    BLANK(),
    [Valor Receita / AIH (conforme origem)] - [Custo Total Hospitalar]
)

Margem de Contribuicao % = 
DIVIDE(
    [Margem de Contribuicao Total],
    [Valor Receita / AIH (conforme origem)],
    BLANK()
)

Custo Medio por Paciente = 
DIVIDE(
    [Custo Total Hospitalar],
    [Total Internacoes],
    BLANK()
)

Custo Medio por Paciente-Dia = 
DIVIDE(
    [Custo Total Hospitalar],
    [Total Dias-Paciente],
    BLANK()
)

Peso OPME no Custo Total % = 
DIVIDE(
    [Custo Total OPME],
    [Custo Total Hospitalar],
    BLANK()
)

Custo Diarias Excedentes Estimado =
// Custo das diárias de pacientes que ultrapassaram o tempo médio de protocolo
VAR _linhas = COUNTROWS(fato_internacoes)
VAR _linhas_completas = COUNTROWS(
    FILTER(
        fato_internacoes,
        NOT ISBLANK(fato_internacoes[dias_permanencia])
            && NOT ISBLANK(fato_internacoes[custo_total])
            && NOT ISBLANK(RELATED(dim_procedimento[tmp_protocolo_previsto]))
    )
)
RETURN
IF(
    _linhas = 0 || _linhas_completas < _linhas,
    BLANK(),
    SUMX(
        fato_internacoes,
        VAR _dias_excedentes = fato_internacoes[dias_permanencia] - RELATED(dim_procedimento[tmp_protocolo_previsto])
        VAR _custo_dia = DIVIDE(fato_internacoes[custo_total], fato_internacoes[dias_permanencia], BLANK())
        RETURN IF(_dias_excedentes > 0, _dias_excedentes * _custo_dia)
    )
)

// ------------------------------------------------------------------------------
// 3. MEDIDAS DE GESTÃO DE LEITOS E CAPACIDADE
// ------------------------------------------------------------------------------

Total Leitos Instalados = 
VAR _setores = COUNTROWS(dim_setor_leito)
VAR _setores_com_capacidade = COUNT(dim_setor_leito[leitos_operacionais])
RETURN IF(_setores = 0 || _setores_com_capacidade < _setores, BLANK(), SUM(dim_setor_leito[leitos_operacionais]))

Dias no Periodo Selecionado = 
COUNTROWS(dim_tempo)

Total Leitos-Dia Disponiveis = 
[Total Leitos Instalados] * [Dias no Periodo Selecionado]

Taxa de Ocupacao Leitos % = 
// Dias por coorte de admissão não são censo diário e não medem ocupação.
// Conecte uma fato de censo diário e capacidade válida por data antes de calcular.
BLANK()

Giro de Leito = 
// Proxy de admissões por leito; não equivale ao giro oficial sem capacidade
// válida no período e contagem consistente de admissões/saídas.
DIVIDE(
    [Total Internacoes],
    [Total Leitos Instalados],
    BLANK()
)

// ------------------------------------------------------------------------------
// 4. MEDIDAS DE QUALIDADE CLÍNICA E DESFECHO
// ------------------------------------------------------------------------------

Total Readmissoes 30d = 
IF(
    [Internacoes com Indicador de Readmissao] = 0,
    BLANK(),
    CALCULATE(
        COUNTROWS(fato_internacoes),
        fato_internacoes[readmissao_30d] = TRUE()
    )
)

Internacoes com Indicador de Readmissao =
CALCULATE(
    COUNTROWS(fato_internacoes),
    NOT ISBLANK(fato_internacoes[readmissao_30d])
)

Taxa de Readmissao 30d % = 
DIVIDE(
    [Total Readmissoes 30d],
    [Internacoes com Indicador de Readmissao],
    BLANK()
)

Internacoes com Indicador de Obito =
CALCULATE(
    COUNTROWS(fato_internacoes),
    NOT ISBLANK(fato_internacoes[indicador_obito])
)

Total Obitos =
IF(
    [Internacoes com Indicador de Obito] = 0,
    BLANK(),
    CALCULATE(
        COUNTROWS(fato_internacoes),
        fato_internacoes[indicador_obito] = 1
    )
)

Taxa de Mortalidade % = 
DIVIDE(
    [Total Obitos],
    [Internacoes com Indicador de Obito],
    BLANK()
)

// ------------------------------------------------------------------------------
// 5. MEDIDAS DE FORMATO E CORES CONDICIONAIS
// ------------------------------------------------------------------------------

Cor Taxa Ocupacao = 
IF(
    ISBLANK([Taxa de Ocupacao Leitos %]),
    "#94A3B8",
    SWITCH(
        TRUE(),
        [Taxa de Ocupacao Leitos %] > 0.85, "#E63946",
        [Taxa de Ocupacao Leitos %] < 0.65, "#F4A261",
        "#2A9D8F"
    )
)

Cor Margem Contribuicao = 
IF(
    ISBLANK([Margem de Contribuicao %]),
    "#94A3B8",
    IF([Margem de Contribuicao %] < 0, "#E63946", "#2A9D8F")
)
