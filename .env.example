# MySQL 8+ com endpoint acessível pelas funções da Vercel.
# Codifique caracteres especiais da senha na URL (por exemplo, @ vira %40).
MYSQL_URL=mysql://usuario:senha@host:3306/hospital_analytics
MYSQL_TLS=true
# PEM da autoridade/certificado que autentica o servidor. Deixe vazio apenas para localhost.
MYSQL_SSL_CA=
# Caminho local para o mesmo PEM ao executar o ETL Python.
MYSQL_SSL_CA_FILE=
MYSQL_CONNECTION_LIMIT=2

# Gere um segredo diferente para cada ambiente: openssl rand -hex 32
AUTH_RATE_LIMIT_SECRET=

# Segredo estável usado pelo pipeline para pseudonimizar identificadores.
# Gere uma vez e mantenha o mesmo valor ao recarregar dados: openssl rand -hex 32
PATIENT_DATA_HMAC_KEY=

# Usado somente ao executar npm run mysql:bootstrap-user localmente.
# O script pede a senha sem exibi-la e não salva este e-mail no Vercel.
INITIAL_ADMIN_EMAIL=
