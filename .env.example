# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SUPABASE & BANCO DE DADOS
# ==============================================================================
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Supabase API (REST / PostgREST)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-anon-publica-ou-service-role
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# ------------------------------------------------------------------------------
# 2. Conexão Direta PostgreSQL (Recomendado para cargas em massa e Power BI)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Modo Direto (Porta 5432):
DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJECT-REF].supabase.co:5432/postgres

# Modo Connection Pooler (Porta 6543 / Session ou Transaction mode para redes IPv4 restritas):
# DATABASE_URL=postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres

