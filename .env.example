# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - SUPABASE & BANCO DE DADOS
# ==============================================================================
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Supabase API (REST / PostgREST)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://seu-projeto.supabase.co
# Use a chave publishable (sb_publishable_...) para a API de leitura.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave
# Compatibilidade com projetos configurados com a antiga chave anon:
SUPABASE_KEY=sua-chave-anon-publica
# A chave publishable/anon também é usada pelo formulário de login no navegador.
# Nunca use SUPABASE_SERVICE_ROLE_KEY ou uma chave secret na aplicação web.
# A API nunca deve usar a chave secret/service_role.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# ------------------------------------------------------------------------------
# 2. Conexão Direta PostgreSQL (carga em massa, com role ETL dedicada)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Modo Direto (Porta 5432):
DATABASE_URL=postgresql://analytics_loader:[SUA-SENHA]@db.[SEU-PROJECT-REF].supabase.co:5432/postgres

# Segredo local usado pelo ETL para pseudonimizar chaves de internação.
# Gere um valor aleatório de pelo menos 32 caracteres; nunca o versione.
PATIENT_DATA_HMAC_KEY=

# Modo Connection Pooler (Porta 6543 / Session ou Transaction mode para redes IPv4 restritas):
# DATABASE_URL=postgresql://analytics_loader.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres

